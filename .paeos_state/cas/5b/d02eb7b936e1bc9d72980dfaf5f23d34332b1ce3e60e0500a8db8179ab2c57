"""Reasoning continuity state — explicit persistence of orchestrated choices and rationale.

Models are ephemeral workers; their raw transcripts are not authoritative state. The
kernel records explicit epistemic state records (linked to evidence and other state nodes)
to build a durable `ReasoningState` that can be fed into new model sessions, ensuring
epistemic independence without losing context.
"""

from __future__ import annotations

from dataclasses import dataclass
from enum import Enum

from kernel.types import Hash, Role

__all__ = [
    "ContextPolicy",
    "ReasoningState",
    "Status",
    "Fact",
    "Constraint",
    "Invariant",
    "Proposal",
    "Hypothesis",
    "Decision",
    "Rejection",
    "Question",
    "Uncertainty",
    "Result",
    "Checkpoint",
]


class ContextPolicy(Enum):
    """How the context compiler filters ReasoningState into a prompt."""
    FULL_CONTINUATION = "FULL_CONTINUATION"
    MINIMUM_SUFFICIENT = "MINIMUM_SUFFICIENT"
    FRESH = "FRESH"
    BLIND_CONCLUSION = "BLIND_CONCLUSION"
    INDEPENDENT_ADVERSARIAL = "INDEPENDENT_ADVERSARIAL"
    DECISION_TARGETED_ADVERSARIAL = "DECISION_TARGETED_ADVERSARIAL"
    RECONSTRUCTION = "RECONSTRUCTION"


class Status(Enum):
    """The status of an epistemic state node, used for invalidation."""
    ACTIVE = "ACTIVE"
    DISPUTED = "DISPUTED"
    SUPERSEDED = "SUPERSEDED"


@dataclass(frozen=True, kw_only=True)
class StateNode:
    """Base class for epistemic state elements."""
    id: str
    producer: Role
    based_on: tuple[str, ...] = ()  # references to other StateNode IDs
    evidence_refs: tuple[Hash, ...] = ()  # references to Evidence hashes
    status: Status = Status.ACTIVE


@dataclass(frozen=True, kw_only=True)
class Fact(StateNode):
    statement: str


@dataclass(frozen=True, kw_only=True)
class Constraint(StateNode):
    statement: str


@dataclass(frozen=True, kw_only=True)
class Invariant(StateNode):
    statement: str


@dataclass(frozen=True, kw_only=True)
class Proposal(StateNode):
    statement: str


@dataclass(frozen=True, kw_only=True)
class Hypothesis(StateNode):
    statement: str


@dataclass(frozen=True, kw_only=True)
class Decision(StateNode):
    subject: str
    rationale: str


@dataclass(frozen=True, kw_only=True)
class Rejection(StateNode):
    rejected_proposal: str
    reason: str


@dataclass(frozen=True, kw_only=True)
class Question(StateNode):
    statement: str


@dataclass(frozen=True, kw_only=True)
class Uncertainty(StateNode):
    statement: str


@dataclass(frozen=True, kw_only=True)
class Result(StateNode):
    statement: str


@dataclass(frozen=True, slots=True)
class ReasoningState:
    """The canonical continuity state of a goal."""
    facts: tuple[Fact, ...] = ()
    constraints: tuple[Constraint, ...] = ()
    invariants: tuple[Invariant, ...] = ()
    proposals: tuple[Proposal, ...] = ()
    hypotheses: tuple[Hypothesis, ...] = ()
    decisions: tuple[Decision, ...] = ()
    rejections: tuple[Rejection, ...] = ()
    questions: tuple[Question, ...] = ()
    uncertainties: tuple[Uncertainty, ...] = ()
    results: tuple[Result, ...] = ()


@dataclass(frozen=True, slots=True)
class Checkpoint:
    """A durable continuity checkpoint to pause/resume across sessions or providers."""
    checkpoint_id: str
    goal_id: str
    run_id: str
    stage: str
    reasoning_state_hash: str
    git_revision: str
    context_revision: str
    active_task: str | None = None
    parent_checkpoint: str | None = None
    invocation_lineage: tuple[str, ...] = ()

