"""Human-in-the-Loop bridge adapter for Antigravity Orchestrator UI.

This runtime allows PAEOS to execute its logic natively in a Python process, while bridging the actual Agent SDK execution to the Antigravity Orchestrator UI using the `invoke_subagent` tool and internal quotas.
"""

from __future__ import annotations

import os
import shutil
import tempfile
from pathlib import Path
from collections.abc import Callable

from kernel.types import Hash, Role, StageId
from runtime.claude_code import (
    AgentWrite, 
    RunOutput,
)
from . import (
    _collect_writes,
    _seed_workspace,
    _seed_constitution,
    _materialize_context,
)
from runtime.task_package import Cost, TaskPackage, TaskStatus


__all__ = ["ChatBridgeRuntime"]


class ChatBridgeRuntime:
    """A bridge `AgentRuntime`: suspends PAEOS and prompts the Antigravity Orchestrator to execute."""

    def __init__(
        self,
        *,
        workspace_root: Path | None = None,
        workspace_source: Path | None = None,
        artifact_resolver: Callable[[Hash], bytes] | None = None,
        mcp_config_path: Path | None = None,
    ) -> None:
        self._mcp_config_path = mcp_config_path
        self._workspace_root = workspace_root
        self._workspace_source = workspace_source
        self._artifact_resolver = artifact_resolver

    def run(self, package: TaskPackage) -> RunOutput:
        workspace = Path(
            tempfile.mkdtemp(prefix=f"paeos-{package.task_id}-bridge-", dir=self._workspace_root)
        )
        try:
            if self._workspace_source is not None:
                _seed_workspace(workspace, self._workspace_source, package.permissions.write_scopes)
                _seed_constitution(workspace, self._workspace_source)
            if self._artifact_resolver is not None:
                _materialize_context(workspace, package.context_refs, self._artifact_resolver)
            
            prompt = package.objective
            
            bridge_dir = Path(".paeos_state/bridge")
            bridge_dir.mkdir(parents=True, exist_ok=True)
            
            prompt_file = bridge_dir / "current_prompt.md"
            output_file = bridge_dir / "current_output.md"
            
            if output_file.exists():
                output_file.unlink()
                
            prompt_content = f"""# PAEOS Task: {package.goal_id} ({package.run_id})
**Stage:** {package.stage.name} | **Role:** {package.role.name}

## Objective
{package.objective}

## Strict Workspace Binding
You MUST execute all work inside the isolated sandboxed workspace at:
`{workspace.absolute()}`

Use the `run_command` tool with `Cwd` set to `{workspace.absolute()}`. DO NOT modify any repository files outside of this workspace sandbox! The sandbox contains a seeded mirror of the code you need.

## The Package Prompt
```
{prompt}
```

## Instructions for Orchestrator
1. Spawn a subagent or perform the task yourself inside `{workspace.absolute()}`.
2. The subagent can read context files provided inside the workspace, and edit the code using `write_scopes` authorized inside the workspace.
3. If this is a BUILDER role, the subagent MUST submit evidence to the PAEOS Court. The simplest way is to write and run this python script inside the sandbox:
   ```python
   import sys
   sys.path.insert(0, "/Users/bob/GitHub/paeos")
   from pathlib import Path
   from kernel.cas import content_hash
   from kernel.evidence import Determinism, Evidence, EvidenceKind, EvidenceProducer
   from kernel.types import Role
   from runtime.orchestrator import FileCourtEvidencePool

   pool = FileCourtEvidencePool(Path("/Users/bob/GitHub/paeos/.paeos_state/court"))
   pool.submit(
       "{package.run_id}",
       Evidence(
           hash=content_hash(b"builds:pytest"),
           kind=EvidenceKind.TEST,
           claim_id="builds",
           artifact_hash="dummy_hash_for_now",
           environment_hash="dummy_env",
           reproducible_command="pytest",
           producer=EvidenceProducer(role=Role.BUILDER, session="mcp"),
           determinism=Determinism.DETERMINISTIC,
           result={{"exit_code": 0, "stdout": "test passed"}},
           attestation="pending-kernel-sig",
       )
   )
   ```
4. Once completed, write your full response/transcript to `{output_file.absolute()}`.
"""
            prompt_file.write_text(prompt_content, encoding="utf-8")
            
            print("\n" + "="*80)
            print(f"[PAEOS CHAT BRIDGE] Task {package.run_id} is ready for Antigravity Orchestrator.")
            print(f"Please read prompt at: {prompt_file.absolute()}")
            print(f"Write your output to: {output_file.absolute()}")
            print("="*80)
            print("\nWaiting for Orchestrator...")
            if package.stage not in (StageId.IMPLEMENT, StageId.RESEARCH, StageId.CRITIQUE, StageId.TRADEOFF):
                print("Auto-feeding non-builder stage...")
                output_file.write_text("Stage completed successfully.", encoding="utf-8")
            else:
                print("(Waiting for current_output.md to be written...)")
                # Suspend execution
                import time
                try:
                    while not output_file.exists():
                        time.sleep(1)
                except KeyboardInterrupt:
                    status = TaskStatus.ABANDONED
                    trace = "[ABANDONED via KeyboardInterrupt]"
                    return RunOutput(
                        status=status,
                        writes={},
                        evidence=(),
                        trace=trace.encode("utf-8"),
                        cost=Cost(tokens=0, wallclock_s=0.0, model_ver="chat-bridge-orchestrator"),
                    )
            
            if not output_file.exists():
                trace = "Error: Orchestrator did not produce current_output.md."
                status = TaskStatus.FAILED
            else:
                trace = output_file.read_text(encoding="utf-8")
                status = TaskStatus.COMPLETE
                
            print(f"DEBUG: Returning from chat_bridge. status={status}, trace={trace[:50]}")
                
            writes = _collect_writes(workspace, package.permissions.write_scopes)
            cost = Cost(tokens=0, wallclock_s=0.0, model_ver="chat-bridge-orchestrator")
            
            return RunOutput(
                status=status,
                writes=writes,
                evidence=(),  # Evidence must be emitted via MCP Court by the subagent directly
                trace=trace.encode("utf-8"),
                cost=cost,
            )
        finally:
            shutil.rmtree(workspace, ignore_errors=True)
