from kernel.rcl import Mission, StateStore, ContextEngine, ContextPackage

def test_rcl_models_and_store():
    store = StateStore()
    m = Mission("1", "test mission")
    store.create_mission(m)
    assert store.get_mission("1") is m

def test_context_engine():
    engine = ContextEngine()
    ctx = engine.build_context()
    assert isinstance(ctx, ContextPackage)
