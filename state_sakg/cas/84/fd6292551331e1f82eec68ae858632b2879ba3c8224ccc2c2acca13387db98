},

"provenance": {
  "type": "object",
  "required": ["origin", "author_kind", "ingested_at", "source_hash"],
  "properties": {
    "origin":      { "$ref": "#/$defs/origin_ref" },
    "author_kind": { "$ref": "#/$defs/author_kind" },
    "ingested_at": { "$ref": "#/$defs/timestamp" },
