  },
  "unevaluatedProperties": false
},

"evidence_ref": {
  "type": "object",
  "description": "SAEOS-1 §3.2.3 / §3.3.3 — a POINTER to evidence living elsewhere. Never the artifact.",
  "required": ["uri", "hash", "kind", "reverify"],
  "properties": {
    "node_id":  { "$ref": "#/$defs/node_id" },
    "uri":      { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*:", "maxLength": 2048 },
    "hash":     { "$ref": "#/$defs/sha256" },
    "kind":     { "enum": ["artifact", "commit", "test_run", "measurement",
                           "incident", "document", "ledger_entry"] },
    "reverify": { "type": "string", "minLength": 1, "maxLength": 512 }
  },
  "not": {
    "anyOf": [
      { "required": ["content"] }, { "required": ["payload"] }, { "required": ["body"] },
      { "required": ["bytes"] },   { "required": ["blob"] },    { "required": ["text"] }
