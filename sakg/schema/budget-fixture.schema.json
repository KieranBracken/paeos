{
  "$id": "https://paeos.local/sakg/schema/budget-fixture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAKG Budget Enforcement Fixture",
  "description": "Deterministic oracle for drop-and-count projection budget behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case", "request", "candidates", "expected"],
  "properties": {
    "schema_version": {"const": "paeos.sakg.budget-fixture/v1"},
    "case": {"type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 1},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget"],
      "properties": {
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_tokens", "max_nodes", "tier"],
          "properties": {
            "max_tokens": {"type": "integer", "minimum": 1},
            "max_nodes": {"type": "integer", "minimum": 1},
            "tier": {"type": "string", "enum": ["SUMMARY", "INDEX", "COMPACT", "DIFF"]}
          }
        }
      }
    },
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained_ids", "retained_tokens", "omitted", "truncated"],
      "properties": {
        "retained_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "retained_tokens": {"type": "integer", "minimum": 0},
        "omitted": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "node_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "namespace", "status", "label", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "const": "Option"},
        "namespace": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["candidate", "canonical", "refuted"]},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_summary", "score", "why", "estimated_tokens"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "node_summary": {"$ref": "#/$defs/node_summary"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "why": {"type": "string", "minLength": 1},
        "estimated_tokens": {"type": "integer", "minimum": 1}
      }
    }
  }
}
