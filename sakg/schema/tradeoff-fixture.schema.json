{
  "$id": "https://paeos.local/sakg/schema/tradeoff-fixture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAKG Tradeoff Precedents Fixture",
  "description": "A deterministic query, ranked Decision set, and explicit Outcome join.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case", "source", "query", "expected"],
  "properties": {
    "schema_version": {"const": "paeos.sakg.tradeoff-fixture/v1"},
    "case": {"type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "query": {"$ref": "#/$defs/query"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results"],
      "properties": {
        "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "inventory_sha256", "heading", "excerpt"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "heading": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "subject", "goal_id", "axes"],
      "properties": {
        "method": {"const": "tradeoff_precedents"},
        "subject": {"type": "string", "minLength": 1},
        "goal_id": {"type": "string", "pattern": "^g-[a-z0-9-]+$"},
        "axes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"const": "realized"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "score", "why", "outcome"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "why": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "outcome": {"$ref": "#/$defs/outcome"}
      }
    }
  }
}
