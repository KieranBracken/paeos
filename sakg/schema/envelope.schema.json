{
  "$id": "https://paeos.local/sakg/schema/envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "canonical"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "refuted"
          }
        }
      },
      "then": {
        "required": [
          "falsifier"
        ]
      }
    }
  ],
  "description": "SAEOS-1 \u00a74.2 envelope; facets hold type-specific content.",
  "properties": {
    "confidence": {
      "description": "Derived by truth maintenance; never authored.",
      "maximum": 1,
      "minimum": 0,
      "readOnly": true,
      "type": "number"
    },
    "coordinates": {
      "additionalProperties": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "artifact",
              "test",
              "report",
              "observation",
              "decision",
              "source"
            ],
            "type": "string"
          },
          "reverification": {
            "minLength": 1,
            "type": "string"
          },
          "uri": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "hash",
          "uri",
          "kind",
          "reverification"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "facets": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "falsifier": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "pattern": "^sakg://[^/]+/(?:Decision|Problem|Option|Constraint|Objective|TradeOff|Mechanism|Pattern|Component|Outcome|Scar|EvidenceRef)/[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "label": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "namespace": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "author_kind": {
          "enum": [
            "human",
            "agent",
            "ingest",
            "inferred"
          ],
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "type": "string"
        },
        "origin": {
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "minLength": 1,
              "type": "string"
            },
            "system": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "system",
            "run_id"
          ],
          "type": "object"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "author_kind",
        "ingested_at",
        "source_hash"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "candidate",
        "canonical",
        "superseded",
        "refuted"
      ],
      "type": "string"
    },
    "summary": {
      "maxLength": 280,
      "type": "string"
    },
    "type": {
      "enum": [
        "Decision",
        "Problem",
        "Option",
        "Constraint",
        "Objective",
        "TradeOff",
        "Mechanism",
        "Pattern",
        "Component",
        "Outcome",
        "Scar",
        "EvidenceRef"
      ],
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "type",
    "namespace",
    "facets",
    "label",
    "summary",
    "provenance",
    "evidence",
    "status",
    "confidence",
    "valid_from",
    "valid_until",
    "falsifier",
    "coordinates"
  ],
  "title": "SAKG Universal Node Envelope",
  "type": "object"
}
