{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concept-os.local/schema/node.schema.json",
  "title": "Concept OS node envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "namespace", "schema_version", "payload", "representations", "provenance_refs", "recorded_at"],
  "properties": {
    "id": {"$ref": "#/$defs/conceptUri"},
    "type": {"$ref": "#/$defs/nodeType"},
    "namespace": {"$ref": "#/$defs/namespace"},
    "schema_version": {"type": "integer", "minimum": 1},
    "payload": {"type": "object"},
    "representations": {"type": "array", "items": {"$ref": "#/$defs/representation"}},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "generator_id": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "graph_snapshot_hash": {"$ref": "#/$defs/hash"},
    "input_uris": {"type": "array", "items": {"$ref": "#/$defs/conceptUri"}},
    "normalized_parameters": {"type": "object"},
    "seed": {"type": "integer"}
  },
  "allOf": [{"oneOf": [
    {"properties": {"type": {"const": "Concept"}, "payload": {"$ref": "#/$defs/conceptPayload"}}, "required": ["type", "payload"]},
    {"properties": {"type": {"const": "Analogy"}, "payload": {"$ref": "#/$defs/analogyPayload"}}, "required": ["type", "payload"]},
    {"properties": {"type": {"const": "Transformation"}, "payload": {"$ref": "#/$defs/transformationPayload"}}, "required": ["type", "payload"]},
    {"properties": {"type": {"const": "SemanticNeighborhood"}, "payload": {"$ref": "#/$defs/neighborhoodPayload"}}, "required": ["type", "payload"]},
    {"properties": {"type": {"const": "InspirationHeuristic"}, "payload": {"$ref": "#/$defs/heuristicPayload"}}, "required": ["type", "payload"]},
    {"properties": {"type": {"const": "Hypothesis"}, "payload": {"$ref": "#/$defs/hypothesisPayload"}}, "required": ["type", "payload"]}
  ]}],
  "$defs": {
    "nodeType": {"enum": ["Concept", "Analogy", "Transformation", "SemanticNeighborhood", "InspirationHeuristic", "Hypothesis"]},
    "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conceptUri": {"type": "string", "pattern": "^concept://[a-z0-9][a-z0-9_-]{0,62}/[a-z0-9][a-z0-9-]{0,62}/[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "ref": {"type": "string", "pattern": "^(concept://[a-z0-9][a-z0-9_-]{0,62}/[a-z0-9][a-z0-9-]{0,62}/[0-7][0-9A-HJKMNP-TV-Z]{25}|[0-9a-f]{64})$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "jsonObject": {"type": "object"},
    "symbolic": {"type": "object", "additionalProperties": false, "required": ["kind", "label", "language", "definition"], "properties": {"kind": {"const": "symbolic"}, "label": {"type": "string", "minLength": 1}, "language": {"type": "string", "minLength": 1}, "definition": {"type": "string", "minLength": 1}, "aliases": {"$ref": "#/$defs/strings"}, "formal_expression": {"type": "string"}}},
    "structural": {"type": "object", "additionalProperties": false, "required": ["kind", "signature_version"], "properties": {"kind": {"const": "structural"}, "signature_version": {"type": "string", "minLength": 1}}},
    "exemplar_refs": {"type": "object", "additionalProperties": false, "required": ["kind", "refs"], "properties": {"kind": {"const": "exemplar_refs"}, "refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}}},
    "vector_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "model", "version", "dimensions", "content_hash", "index_revision"], "properties": {"kind": {"const": "vector_ref"}, "model": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "dimensions": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/hash"}, "index_revision": {"type": "string", "minLength": 1}}},
    "probabilistic_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "distribution_family", "version", "content_hash"], "properties": {"kind": {"const": "probabilistic_ref"}, "distribution_family": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "content_hash": {"$ref": "#/$defs/hash"}}},
    "procedural_affordance": {"type": "object", "additionalProperties": false, "required": ["kind", "transformation_uris"], "properties": {"kind": {"const": "procedural_affordance"}, "transformation_uris": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conceptUri"}}}},
    "source_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "uri", "content_hash"], "properties": {"kind": {"const": "source_ref"}, "uri": {"type": "string", "format": "uri"}, "content_hash": {"$ref": "#/$defs/hash"}}},
    "representation": {"oneOf": [{"$ref": "#/$defs/symbolic"}, {"$ref": "#/$defs/structural"}, {"$ref": "#/$defs/exemplar_refs"}, {"$ref": "#/$defs/vector_ref"}, {"$ref": "#/$defs/probabilistic_ref"}, {"$ref": "#/$defs/procedural_affordance"}, {"$ref": "#/$defs/source_ref"}]},
    "conceptPayload": {"type": "object", "additionalProperties": false, "required": ["label", "description", "domain_tags"], "properties": {"label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "domain_tags": {"$ref": "#/$defs/strings"}, "aliases": {"$ref": "#/$defs/strings"}, "formal_expression": {"type": "string"}, "declared_constraints": {"$ref": "#/$defs/jsonObject"}, "scope_notes": {"type": "string"}}},
    "correspondence": {"type": "object", "additionalProperties": false, "required": ["source_role", "target_role", "source_uri", "target_uri"], "properties": {"source_role": {"type": "string", "minLength": 1}, "target_role": {"type": "string", "minLength": 1}, "source_uri": {"$ref": "#/$defs/conceptUri"}, "target_uri": {"$ref": "#/$defs/conceptUri"}}},
    "analogyPayload": {"type": "object", "additionalProperties": false, "required": ["source_roles", "target_roles", "correspondences", "preserved_relations", "known_breaks", "metric_snapshot", "heuristic_uri"], "properties": {"source_roles": {"$ref": "#/$defs/strings"}, "target_roles": {"$ref": "#/$defs/strings"}, "correspondences": {"type": "array", "items": {"$ref": "#/$defs/correspondence"}}, "preserved_relations": {"$ref": "#/$defs/strings"}, "known_breaks": {"type": "array", "items": {"type": "string"}}, "metric_snapshot": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}}, "heuristic_uri": {"$ref": "#/$defs/conceptUri"}}, "allOf": [{"anyOf": [{"properties": {"known_breaks": {"minItems": 1}}}, {"properties": {"known_breaks": {"contains": {"const": "not_yet_tested"}}}}]}]},
    "transformationPayload": {"type": "object", "additionalProperties": false, "required": ["operator_name", "operator_version", "input_signature", "output_signature", "preconditions", "postconditions", "parameters_schema", "determinism", "implementation_ref"], "properties": {"operator_name": {"type": "string", "minLength": 1}, "operator_version": {"type": "string", "minLength": 1}, "input_signature": {"type": "object"}, "output_signature": {"type": "object"}, "preconditions": {"$ref": "#/$defs/strings"}, "postconditions": {"$ref": "#/$defs/strings"}, "parameters_schema": {"type": "object"}, "determinism": {"enum": ["declarative", "pure", "seeded", "external"]}, "implementation_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]} }},
    "pathStep": {"type": "object", "additionalProperties": false, "required": ["uri", "family", "relation"], "properties": {"uri": {"$ref": "#/$defs/conceptUri"}, "family": {"type": "string"}, "relation": {"type": "string"}}},
    "member": {"type": "object", "additionalProperties": false, "required": ["uri", "rank", "component_distances", "aggregate_distance", "why"], "properties": {"uri": {"$ref": "#/$defs/conceptUri"}, "rank": {"type": "integer", "minimum": 1}, "component_distances": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}}, "aggregate_distance": {"$ref": "#/$defs/decimal"}, "why": {"type": "array", "items": {"$ref": "#/$defs/pathStep"}}}},
    "neighborhoodPayload": {"type": "object", "additionalProperties": false, "required": ["anchor_uris", "metric_versions", "weights", "filters", "budget", "members", "omitted", "truncated", "graph_snapshot_hash", "query_hash"], "properties": {"anchor_uris": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conceptUri"}}, "metric_versions": {"type": "object"}, "weights": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}}, "filters": {"type": "object"}, "budget": {"type": "object"}, "members": {"type": "array", "items": {"$ref": "#/$defs/member"}}, "omitted": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}, "graph_snapshot_hash": {"$ref": "#/$defs/hash"}, "query_hash": {"$ref": "#/$defs/hash"}}},
    "heuristicPayload": {"type": "object", "additionalProperties": false, "required": ["name", "version", "kind", "parameters_schema", "required_representations", "score_components", "cost_class", "falsifier"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "kind": {"enum": ["analogy", "recombination", "gap", "novelty", "serendipity", "compression"]}, "parameters_schema": {"type": "object"}, "required_representations": {"type": "array", "items": {"enum": ["symbolic", "structural", "exemplar_refs", "vector_ref", "probabilistic_ref", "procedural_affordance", "source_ref"]}}, "score_components": {"$ref": "#/$defs/strings"}, "cost_class": {"type": "string", "minLength": 1}, "falsifier": {"type": "string", "minLength": 1}}},
    "scoreSnapshot": {"type": "object", "additionalProperties": false, "required": ["relevance", "novelty", "coherence", "diversity_contribution", "cost", "provenance_completeness"], "properties": {"relevance": {"$ref": "#/$defs/decimal"}, "novelty": {"$ref": "#/$defs/decimal"}, "coherence": {"$ref": "#/$defs/decimal"}, "diversity_contribution": {"$ref": "#/$defs/decimal"}, "cost": {"$ref": "#/$defs/decimal"}, "provenance_completeness": {"$ref": "#/$defs/decimal"}}},
    "hypothesisPayload": {"type": "object", "additionalProperties": false, "required": ["proposition", "scope", "assumptions", "lineage", "expected_observations", "falsifiers", "lifecycle", "score_snapshot"], "properties": {"proposition": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "assumptions": {"$ref": "#/$defs/strings"}, "lineage": {"type": "array", "items": {"$ref": "#/$defs/conceptUri"}}, "expected_observations": {"$ref": "#/$defs/strings"}, "falsifiers": {"$ref": "#/$defs/strings", "minItems": 1}, "lifecycle": {"enum": ["draft", "candidate", "exported", "dismissed", "superseded"]}, "score_snapshot": {"$ref": "#/$defs/scoreSnapshot"}}}
  }
}
