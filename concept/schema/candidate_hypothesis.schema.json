{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concept-os.local/schema/candidate_hypothesis.schema.json",
  "title": "Exploratory candidate hypothesis envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_id", "schema_version", "proposal_kind", "authority", "trust", "hypothesis_uri", "proposition", "scope", "assumptions", "expected_observations", "falsifiers", "source_refs", "replay_manifest", "score_vectors", "graph_snapshot_hash", "content_hashes", "requested_evaluation_kind"],
  "properties": {"envelope_id": {"type": "string", "pattern": "^concept://[a-z0-9][a-z0-9_-]{0,62}/outbox/[0-7][0-9A-HJKMNP-TV-Z]{25}$"}, "schema_version": {"type": "integer", "minimum": 1}, "proposal_kind": {"const": "exploratory_hypothesis"}, "authority": {"const": "exploratory"}, "trust": {"const": "untrusted_candidate"}, "hypothesis_uri": {"$ref": "#/$defs/uri"}, "proposition": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "assumptions": {"$ref": "#/$defs/strings"}, "expected_observations": {"$ref": "#/$defs/strings"}, "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "replay_manifest": {"type": "object", "required": ["query_hash", "graph_snapshot_hash", "algorithms", "seeds", "budgets", "generator_trace"], "properties": {"query_hash": {"$ref": "#/$defs/hash"}, "graph_snapshot_hash": {"$ref": "#/$defs/hash"}, "algorithms": {"type": "array"}, "seeds": {"type": "object"}, "budgets": {"type": "object"}, "generator_trace": {"type": "array"}}}, "score_vectors": {"type": "object", "additionalProperties": false, "required": ["evidentiary", "components"], "properties": {"evidentiary": {"const": false}, "components": {"type": "object"}}}, "graph_snapshot_hash": {"$ref": "#/$defs/hash"}, "content_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}}, "requested_evaluation_kind": {"type": "string", "minLength": 1}},
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uri": {"type": "string", "pattern": "^concept://[a-z0-9][a-z0-9_-]{0,62}/[a-z0-9][a-z0-9-]{0,62}/[0-7][0-9A-HJKMNP-TV-Z]{25}$"}, "ref": {"type": "string", "pattern": "^(concept://[a-z0-9][a-z0-9_-]{0,62}/[a-z0-9][a-z0-9-]{0,62}/[0-7][0-9A-HJKMNP-TV-Z]{25}|[0-9a-f]{64})$"}, "strings": {"type": "array", "items": {"type": "string", "minLength": 1}}}
}
