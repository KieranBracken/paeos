.DS_Store
node_modules/
*.log
.scratch/
.runtime/          # PAEOS-9 compiled-context cache: rebuildable from the corpus every boot, never authoritative (H-08/D1)

# --- Python / uv (B0.0) ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# --- secrets / keys (PAEOS-8 §9 T2: signing keys & API credentials live OUT of the repo) ---
ops/keys/*
!ops/keys/.gitkeep
.env
.env.*
!.env.example
*.key
.config/



# Runtime state and evidence live under an explicit external state root.
.paeos_state/
.state/
state_sakg/

# --- patch artifacts ---
*.rej
*.orig
