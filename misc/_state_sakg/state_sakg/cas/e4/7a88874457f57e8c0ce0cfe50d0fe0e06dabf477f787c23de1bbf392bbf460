goals: [<id>, <id>, <id>]
n_scored: <int>
n_extractable: <int>
n_partial: <int>
n_absent: <int>
absent_ratio: <0.dd>
partial_ratio: <0.dd>
verdict: GO
loss_ratio: 0.dd
verdict_scope: <string|null>
failing_conditions: []
matrix_variant: full | reduced
---

