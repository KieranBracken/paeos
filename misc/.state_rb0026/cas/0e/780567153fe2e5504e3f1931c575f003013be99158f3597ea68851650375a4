{"ts":"2026-08-18T15:26:43.828Z","type":"agent_event","event":{"type":"content_start","contentType":"tool","toolCallId":"call_9f6c1177f7b94d37987189fe","toolName":"run_commands","input":{"commands":["cd /var/folders/b0/hb9_mxhn4nz09tzctglbjq6w0000gp/T/paeos-t-a730e3e834b5-xhykd82b && cat > mitigation/verify_mitigation_coverage.py << 'EOF'\n\"\"\"L07 gate proof for RB-0026: mechanically verify the mitigation catalogue.\n\nLoads mitigation/mitigation_catalogue_rb0026.json into the canonical\n`runtime.mitigation.MitigationCatalogue` guard and asserts:\n  1. every HIGH-severity hazard carries at least one safeguard (exit guard),\n  2. every emitted hazard is bound by a safeguard OR an explicit accepted-risk record,\n  3. every safeguard.hazard_id / accepted_risk.hazard_id references a real hazard,\n  4. safeguard mechanisms are from the canonical set.\n\nRun: uv run python mitigation/verify_mitigation_coverage.py  (exit 0 = proof holds)\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport sys\nfrom pathlib import Path\n\nfrom runtime.mitigation import AcceptedRisk, MitigationCatalogue, Safeguard, TradeoffHazard\n\n_CATALOGUE = Path(__file__).with_name(\"mitigation_catalogue_rb0026.json\")\n_VALID_MECHANISMS = {\"KILL_SWITCH\", \"FALLBACK\", \"SHADOW_MODE\", \"SAFETY_CONSTRAINT\"}\n\n\ndef main() -> int:\n    raw = json.loads(_CATALOGUE.read_text(encoding=\"utf-8\"))\n    hazards = tuple(TradeoffHazard(**h) for h in raw[\"hazards\"])\n    safeguards = tuple(Safeguard(**s) for s in raw[\"safeguards\"])\n    accepted_risks = tuple(AcceptedRisk(**a) for a in raw[\"accepted_risks\"])\n    catalogue = MitigationCatalogue(\n        hazards=hazards, safeguards=safeguards, accepted_risks=accepted_risks\n    )\n\n    # 1. canonical exit guard: HIGH hazards must carry a safeguard.\n    assert catalogue.has_high_severity_coverage(), \"uncovered HIGH-severity hazard\"\n    high = {h.id for h in hazards if h.severity.upper() == \"HIGH\"}\n    safeguarded = {s.hazard_id for s in safeguards}\n    assert high and high <= safeguarded, f\"HIGH hazards without safeguard: {high - safeguarded}\"\n\n    # 2. every hazard bound by safeguard OR accepted-risk record.\n    covered = safeguarded | {r.hazard_id for r in accepted_risks}\n    unbound = {h.id for h in hazards} - covered\n    assert not unbound, f\"hazards with neither safeguard nor accepted risk: {sorted(unbound)}\"\n\n    # 3. references resolve to real hazards; mechanisms canonical; severities canonical.\n    hazard_ids = {h.id for h in hazards}\n    for s in safeguards:\n        assert s.hazard_id in hazard_ids, f\"{s.id} references unknown hazard {s.hazard_id}\"\n        assert s.mechanism in _VALID_MECHANISMS, f\"{s.id} bad mechanism {s.mechanism}\"\n    for r in accepted_risks:\n        assert r.hazard_id in hazard_ids, f\"{r.id} references unknown hazard {r.hazard_id}\"\n    for h in hazards:\n        assert h.severity.upper() in {\"HIGH\", \"MEDIUM\", \"LOW\"}, f\"{h.id} bad severity\"\n\n    print(\n        f\"OK: {len(high)}/{len(high)} HIGH hazards safeguarded; \"\n        f\"{len(covered)}/{len(hazards)} hazards covered; catalogue valid\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\nEOF\nuv run python mitigation/verify_mitigation_coverage.py; echo \"exit=$?\""]}}}
